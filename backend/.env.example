# Conexão da aplicação (usuário SEM ser dono das tabelas, para o RLS valer).
# No Neon, copie a connection string do painel. "postgresql://" já é aceito.
DATABASE_URL=postgresql://ff_app:ff_app@localhost:5432/farmaciafacil

# Conexão usada pelas migrações e scripts de administração (dono das tabelas).
MIGRATION_DATABASE_URL=postgresql://ff_owner:ff_owner@localhost:5432/farmaciafacil

# Nome do usuário de banco da aplicação, que recebe as permissões na migração.
APP_DB_ROLE=ff_app

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-isto
JWT_EXPIRA_HORAS=12

# NFC-e: desligado | falso (simula a SEFAZ) | focus
NFCE_PROVEDOR=desligado
# Tokens da empresa no painel da Focus NFe (o certificado A1 e o CSC são cadastrados lá).
FOCUS_NFE_TOKEN_HOMOLOGACAO=
FOCUS_NFE_TOKEN_PRODUCAO=
