# Copie este arquivo para ".env" e preencha.

# Endereço do computador servidor na rede da loja (o IP fixo dele, ex.: 192.168.0.10).
ENDERECO=192.168.0.10

# Senha do banco de dados. Gere uma longa e guarde num lugar seguro.
SENHA_BANCO=troque-esta-senha

# Chave das sessões. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-isto

# Onde ficam as cópias de segurança (de preferência um HD externo ou uma pasta sincronizada com a nuvem).
PASTA_COPIAS=./copias

# NFC-e: desligado | focus. Os tokens ficam no painel da Focus NFe.
NFCE_PROVEDOR=desligado
FOCUS_NFE_TOKEN_HOMOLOGACAO=
FOCUS_NFE_TOKEN_PRODUCAO=

# Assistente de IA (opcional). Sem a chave, o assistente fica desligado.
ANTHROPIC_API_KEY=

# Licença. A chave pública vem de quem vende o sistema (é a mesma em todas as farmácias e não é segredo).
# Com ela preenchida, o sistema só funciona com licença ativada em https://<ENDERECO>/licenca.
LICENCA_CHAVE_PUBLICA=
# Endereço da central de licenças, para ativar com a chave e renovar sozinho pela internet.
LICENCAS_URL=
